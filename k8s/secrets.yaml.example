# ===================================================================
# LuxeShop Kubernetes Secrets Template
# Copy this file to k8s/secrets.yaml and adjust values before applying:
#   cp k8s/secrets.yaml.example k8s/secrets.yaml
#   kubectl apply -f k8s/secrets.yaml
#
# Base64 encode values using:
#   echo -n 'your_value' | base64
# ===================================================================

apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: luxeshop
type: Opaque
data:
  # echo -n 'mongodb://mongo-service:27017/luxeshop' | base64
  MONGO_URI: bW9uZ29kYjovL21vbmdvLXNlcnZpY2U6MjcwMTcvbHV4ZXNob3A=
  # echo -n 'luxeshop_dev_jwt_secret_change_in_production' | base64
  JWT_SECRET: bHV4ZXNob3BfZGV2X2p3dF9zZWNyZXRfY2hhbmdlX2luX3Byb2R1Y3Rpb24=
---
apiVersion: v1
kind: Secret
metadata:
  name: mongo-secret
  namespace: luxeshop
type: Opaque
data:
  # echo -n 'admin' | base64
  MONGO_INITDB_ROOT_USERNAME: YWRtaW4=
  # echo -n 'mongopassword123' | base64
  MONGO_INITDB_ROOT_PASSWORD: bW9uZ29wYXNzd29yZDEyMw==
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: luxeshop
type: Opaque
data:
  # echo -n 'admin' | base64
  admin-user: YWRtaW4=
  # echo -n 'admin123' | base64
  admin-password: YWRtaW4xMjM=

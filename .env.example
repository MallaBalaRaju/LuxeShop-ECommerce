# ===================================================================
# LuxeShop Environment Variables — Example
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets to git.
# ===================================================================

# ─── Backend ─────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/luxeshop
JWT_SECRET=your_jwt_secret_min_32_chars_change_this

# Production / development
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ─── Grafana (used by docker-compose) ────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

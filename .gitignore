.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
tfplan
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ─── Test coverage ────────────────────────────────────────────────────
coverage/

# ─── Build artifacts ──────────────────────────────────────────────────
build/
dist/

# ─── Logs ─────────────────────────────────────────────────────────────
*.log

# ─── IDE / Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Credentials and keys ─────────────────────────────────────────────
*.pem
*.key
kubeconfig
kubeconfig.yaml
.kube/

# ─── Python cache ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]

